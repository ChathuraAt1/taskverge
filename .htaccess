<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Security: Block direct access to hidden files/folders (except .well-known)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Security: Block direct access to sensitive config, build, and repository files
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|CLAUDE\.md|AGENTS\.md|README\.md)$ - [F,L,NC]

    # Security: Block direct access to internal Laravel directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L,NC]

    # Rewrite all web requests to the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
