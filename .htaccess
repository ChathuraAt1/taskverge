<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Security: Block direct access to hidden files and directories (e.g. .env, .git)
    RewriteRule (^|/)\.(?!well-known) - [F]

    # Security: Block direct access to sensitive root configuration and source files
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|CLAUDE\.md|AGENTS\.md|README\.md)$ - [F,L,NC]
    RewriteRule \.(env|lock|xml|md|yml|yaml)$ - [F,L,NC]

    # Rewrite all remaining web traffic to the /public directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
